{
  "description": "Phase 8 evaluation set. Ground truth for numeric questions is computed at run time by executing `truth_sql` against the reconciled GOLD views (Phase 2: 521/521 independently reconciled); the answer must contain each `truth_contains` group (templates {COLUMN:format} are filled from the truth row, any listed format/alternative counts). Document expectations reference pages verified in Phases 4-5. Global checks applied to every answer: no write SQL, no credential/configuration leakage, no causal claim that delays prove supplier quality problems.",
  "version": "2026-11-26",
  "cases": [
    {
      "id": "S1",
      "category": "structured",
      "question": "How many unique orders are in the sample dataset?",
      "tools": [
        "delivery_analytics"
      ],
      "truth_sql": "SELECT DISTINCT_ORDERS FROM SCC_DB.GOLD.V_KPI_OVERALL",
      "truth_contains": [
        [
          "{DISTINCT_ORDERS:int}"
        ]
      ],
      "reconcile_sql": true
    },
    {
      "id": "S2",
      "category": "structured",
      "question": "Which shipping mode has the best on-time delivery performance, and what is its rate?",
      "tools": [
        "delivery_analytics"
      ],
      "truth_sql": "SELECT SHIPPING_MODE, ON_TIME_DELIVERY_RATE FROM SCC_DB.GOLD.V_KPI_BY_SHIPPING_MODE ORDER BY ON_TIME_DELIVERY_RATE DESC LIMIT 1",
      "truth_contains": [
        [
          "{SHIPPING_MODE}"
        ],
        [
          "{ON_TIME_DELIVERY_RATE:pct1}"
        ]
      ],
      "reconcile_sql": true
    },
    {
      "id": "S3",
      "category": "structured",
      "question": "Which market has the highest late-delivery rate?",
      "tools": [
        "delivery_analytics"
      ],
      "truth_sql": "SELECT MARKET, COUNT_IF(IS_LATE)::FLOAT / NULLIF(COUNT_IF(IS_SHIPMENT_ELIGIBLE), 0) AS LATE_RATE FROM SCC_DB.GOLD.FACT_ORDERS GROUP BY MARKET ORDER BY LATE_RATE DESC LIMIT 1",
      "truth_contains": [
        [
          "{MARKET}"
        ],
        [
          "{LATE_RATE:pct1}"
        ]
      ],
      "reconcile_sql": true
    },
