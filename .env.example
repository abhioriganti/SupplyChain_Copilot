# Copy to .env (gitignored) and fill in locally. Never commit .env.
# Auth is key-pair only: the private key file lives OUTSIDE this repo.

SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=SCC_SVC
SNOWFLAKE_ROLE=SCC_DEV_ROLE
SNOWFLAKE_WAREHOUSE=SCC_WH
SNOWFLAKE_DATABASE=SCC_DB

# Absolute path to the PKCS#8 private key, e.g. C:\Users\<you>\.snowflake\keys\scc_svc_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PATH=
# Only if the key was generated with a passphrase; otherwise leave empty.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Runtime (app/agent) user: holds ONLY SCC_APP_ROLE, secondary roles disabled.
# See sql/70_agent/00c_app_service_user.sql. Separate key pair, also outside the repo.
SNOWFLAKE_APP_USER=SCC_APP_SVC
SNOWFLAKE_APP_PRIVATE_KEY_PATH=
SNOWFLAKE_APP_ROLE=SCC_APP_ROLE

# Set to 1 to enable pytest integration tests that hit Snowflake.
SCC_RUN_SNOWFLAKE_TESTS=0
